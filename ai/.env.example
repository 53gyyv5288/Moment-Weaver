# Moment Weaver AI - 环境变量样例
# 复制为 .env 并填入真实值，.env 已加入 .gitignore

# ===== LLM（M2 启用）=====
# OpenAI 兼容协议（/chat/completions + SSE 流式）
# 当前项目用 MiniMax-M3；按你拿到的服务商把下面三个值替换掉
#   LLM_BASE_URL 形如 https://<host>/<path>  （结尾不要带 /v1 之外的多余路径）
#   LLM_API_KEY   服务商发的密钥（sk-cp-... 之类）
#   LLM_MODEL     实际模型名（MiniMax-M3）
# LLM_API_KEY 不要提交到 git；.env 已在 .gitignore 里
LLM_BASE_URL=REPLACE_WITH_YOUR_LLM_BASE_URL
LLM_API_KEY=sk-cp-REPLACE_WITH_YOUR_KEY
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ===== 历史供应商（保留兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 业务后端
MOMENT_BACKEND_URL=http://localhost:8080

# 中间件
MONGO_URI=mongodb://localhost:27017
MONGO_DB=moment_weaver
REDIS_URL=redis://localhost:6379/0

# 日志
LOG_LEVEL=INFO
