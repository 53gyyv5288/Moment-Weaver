# Moment Weaver AI - 环境变量样例
# 复制为 .env 并填入真实值，.env 已加入 .gitignore

# ===== LLM（M2 启用）=====
# OpenAI 兼容协议；可指向 DeepSeek / 通义千问 DashScope / Ollama / vLLM / LM Studio
# 把以下三个值替换成你的 MiniMax 2.7 服务的对应配置即可
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ===== 历史供应商（保留兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 业务后端
MOMENT_BACKEND_URL=http://localhost:8080

# 中间件
MONGO_URI=mongodb://localhost:27017
MONGO_DB=moment_weaver
REDIS_URL=redis://localhost:6379/0

# 日志
LOG_LEVEL=INFO
