# 部署到阿里云 ECS 时复制为 .env，**严禁**入 git
MYSQL_ROOT_PASSWORD=
MYSQL_USER=admin
MYSQL_PASSWORD=

DEEPSEEK_API_KEY=

# ============ RAG（M6+）============
# DashScope Embedding（text-embedding-v3 多语种 1024 维）
DASHSCOPE_API_KEY=

# Milvus Standalone（docker compose 一行起）
MILVUS_URI=http://milvus:19530
MILVUS_DB=default

# ai-reranker 独立服务（bge-reranker-v2-m3）
RERANKER_URL=http://ai-reranker:9001

# 内部服务共享密钥：Spring AI 服务之间相互调用时校验。
# 本地 dev 可不设（用默认 moment-internal-dev-secret-change-me）；
# 生产必须改成强随机值，**两处必须一致**（Spring + AI 各一个 env var，同一个值）：
#   MOMENT_INTERNAL_SECRET -> Spring 端 moment.security.internal-secret
#   MOMENT_INTERNAL_SECRET -> AI 端 rag_internal_secret（同名环境变量）
MOMENT_INTERNAL_SECRET=
